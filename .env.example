# .env dosyasına kopyalayıp tüm placeholder değerlerini değiştirin; gerçek sırları Git’e eklemeyin.
# PostgreSQL kalıcı uygulama verisidir; Redis parolası geçici kabul sayacı servisini korur.
POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_local_database_password
REDIS_PASSWORD=replace_with_local_redis_password

# Yalnızca backend: Google Console kurulumu sonrası google profilini ekleyin.
# Bu sırları VITE_ önekiyle veya başka yolla frontend paketine taşımayın.
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret

# İsteğe bağlı ai profili: AI_CHAT_MODEL API hesabınızın erişebildiği gerçek model adı olmalıdır.
OPENAI_API_KEY=replace_with_openai_api_key
AI_CHAT_MODEL=replace_with_available_chat_model

# Varsayılan container profilleri dış sağlayıcı kimlik bilgisi istemez; model/teşhis simülasyonu etiketlidir.
BACKEND_PROFILES=container,temporal,mcp
# Dış kimlik bilgileriyle: container,temporal,mcp,google,ai
# PT1H ISO-8601 biçiminde bir saattir; son satır varsayılan bir dakikalık pencerede kabul sayısıdır.
APPROVAL_TIMEOUT=PT1H
INVESTIGATION_RATE_LIMIT=5
