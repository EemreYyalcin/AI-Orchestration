# Copy to .env and replace every placeholder. Never commit actual credentials.
POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_local_database_password
REDIS_PASSWORD=replace_with_local_redis_password

# Backend only: activate profiles local,google after Google Console setup.
# Never prefix these with VITE_ or expose them to the frontend.
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret

# Optional backend AI profile. AI_CHAT_MODEL must name a model available to your API account.
OPENAI_API_KEY=replace_with_openai_api_key
AI_CHAT_MODEL=replace_with_available_chat_model

# Container defaults need no external credentials; simulation is visibly labelled.
BACKEND_PROFILES=container,temporal,mcp
# With credentials: container,temporal,mcp,google,ai
APPROVAL_TIMEOUT=PT1H
INVESTIGATION_RATE_LIMIT=5
